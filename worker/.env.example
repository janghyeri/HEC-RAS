# worker/.env — 워커 PC에만 둔다 (커밋 금지, .gitignore에 있음)
# Supabase 대시보드 → Project Settings → API 에서 복사
SUPABASE_URL=https://<프로젝트>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# 웹에 보이는 계산 서버 이름
WORKER_ID=knuwater-24core
JOBS_DIR=C:\Hec-Ras\HECRASMCP\jobs
RAS_EXE=C:\Program Files (x86)\HEC\HEC-RAS\6.6\Ras.exe
MODEL_VERSIONS=v1
# 1이면 결과 HDF(약 110 MB)를 작업 폴더에 남김 (검증용)
KEEP_HDF=1
