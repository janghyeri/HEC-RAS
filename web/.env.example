# 브이월드 인증키 — 실제 값은 web/.env.local (커밋 금지) 또는 Vercel 환경 변수에 넣는다.
# 개발용 키는 서비스 URL http://localhost:3000, 배포용 키는 https://hinnamno-flood.vercel.app 로 발급받았다.
NEXT_PUBLIC_VWORLD_KEY=

# Supabase (계산 요청·결과) — 공개(anon) 키라 브라우저에 보여도 되며, 권한은 DB(RLS)가 정한다.
# service_role 키는 여기에 넣지 않는다 (워커 PC worker/.env 에만).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
